{
  "name": "whales-rewards",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": "26.12.0"
  },
  "scripts": {
    "dev": "TZ=UTC NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "TZ=UTC NEXT_TELEMETRY_DISABLED=1 next build && node src/client/sw/build.mjs",
    "start": "TZ=UTC NEXT_TELEMETRY_DISABLED=1 next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "TZ=UTC vitest run --project unit",
    "test:integration": "TZ=UTC vitest run --project integration",
    "test:time": "TZ=UTC vitest run --project time && TZ=America/New_York vitest run --project time",
    "test:e2e": "TZ=UTC playwright test",
    "db:migrate:dev": "prisma migrate dev --create-only",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "job:retention": "node jobs/retention.ts",
    "job:orphans": "node jobs/orphans.ts",
    "job:reconcile-uploads": "node jobs/reconcile-uploads.ts",
    "job:backup-manifest": "node jobs/backup-manifest.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1162.0",
    "@aws-sdk/s3-request-presigner": "3.1162.0",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.17",
    "dexie": "^4.4.7",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "uuid": "14.0.3",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.5",
    "fake-indexeddb": "^6.2.7",
    "fast-check": "4.10.2",
    "pg": "8.23.1",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}

# Auto-mode command permissions (WHR-37 + hotfix 4 Nov). Guard hook and branch protection still apply.
prefix_rule(pattern = ["git"], decision = "allow", justification = "Git must write .git outside the sandbox; guard hook and branch protection still apply.")
prefix_rule(pattern = ["cd"], decision = "allow", justification = "Lets cd-then-git chains run; cd has no effect of its own.")
prefix_rule(pattern = ["gh", "pr"], decision = "allow", justification = "Reviewed pull-request workflow.")
prefix_rule(pattern = ["gh", "run"], decision = "allow", justification = "CI inspection and reruns.")
prefix_rule(pattern = ["gh", "auth", "status"], decision = "allow", justification = "Authentication check.")
prefix_rule(pattern = ["gh", "repo", "view"], decision = "allow", justification = "Read-only repository lookup.")
prefix_rule(pattern = ["docker", "compose"], decision = "allow", justification = "Local Postgres, Mailpit and MinIO.")
prefix_rule(pattern = ["gh", "api"], decision = "forbidden", justification = "Raw API calls can change repository settings; Earl runs them.")
prefix_rule(pattern = ["gh", "repo", "create"], decision = "forbidden", justification = "Repository administration stays with Earl.")
prefix_rule(pattern = ["gh", "repo", "delete"], decision = "forbidden", justification = "Repository administration stays with Earl.")
prefix_rule(pattern = ["gh", "repo", "edit"], decision = "forbidden", justification = "Repository administration stays with Earl.")
prefix_rule(pattern = ["gh", "repo", "rename"], decision = "forbidden", justification = "Repository administration stays with Earl.")
prefix_rule(pattern = ["gh", "repo", "archive"], decision = "forbidden", justification = "Repository administration stays with Earl.")
prefix_rule(pattern = ["gh", "secret"], decision = "forbidden", justification = "Secrets stay with Earl.")
prefix_rule(pattern = ["gh", "variable"], decision = "forbidden", justification = "Repository settings stay with Earl.")
prefix_rule(pattern = ["gh", "ruleset"], decision = "forbidden", justification = "Branch rules stay with Earl.")
prefix_rule(pattern = ["doctl"], decision = "forbidden", justification = "Cloud changes are T2: Earl runs them.")
prefix_rule(pattern = ["terraform"], decision = "forbidden", justification = "Cloud changes are T2: Earl runs them.")

# WHR-37: explicit command permissions; guard hooks and branch protection still apply.
prefix_rule(pattern = ["git", "add"], decision = "allow", justification = "Permit approved repository add operations; preserve guard and worktree rules.")
prefix_rule(pattern = ["git", "commit"], decision = "allow", justification = "Permit approved repository commit operations; preserve guard and worktree rules.")
prefix_rule(pattern = ["git", "worktree"], decision = "allow", justification = "Permit approved repository worktree operations; preserve guard and worktree rules.")
prefix_rule(pattern = ["git", "fetch"], decision = "allow", justification = "Permit approved repository fetch operations; preserve guard and worktree rules.")
prefix_rule(pattern = ["git", "pull"], decision = "allow", justification = "Permit approved repository pull operations; preserve guard and worktree rules.")
prefix_rule(pattern = ["git", "push"], decision = "allow", justification = "Permit approved repository push operations; preserve guard and worktree rules.")
prefix_rule(pattern = ["git", "switch"], decision = "allow", justification = "Permit approved repository switch operations; preserve guard and worktree rules.")
prefix_rule(pattern = ["git", "checkout"], decision = "allow", justification = "Permit approved repository checkout operations; preserve guard and worktree rules.")
prefix_rule(pattern = ["git", "branch"], decision = "allow", justification = "Permit approved repository branch operations; preserve guard and worktree rules.")
prefix_rule(pattern = ["git", "restore"], decision = "allow", justification = "Permit approved repository restore operations; preserve guard and worktree rules.")
prefix_rule(pattern = ["git", "rm"], decision = "allow", justification = "Permit approved repository rm operations; preserve guard and worktree rules.")
prefix_rule(pattern = ["git", "mv"], decision = "allow", justification = "Permit approved repository mv operations; preserve guard and worktree rules.")
prefix_rule(pattern = ["git", "rebase"], decision = "allow", justification = "Permit approved repository rebase operations; preserve guard and worktree rules.")
prefix_rule(pattern = ["git", "stash"], decision = "allow", justification = "Permit approved repository stash operations; preserve guard and worktree rules.")
prefix_rule(pattern = ["git", "merge-base"], decision = "allow", justification = "Permit approved repository merge-base operations; preserve guard and worktree rules.")
prefix_rule(pattern = ["git", "status"], decision = "allow", justification = "Permit approved repository status operations; preserve guard and worktree rules.")
prefix_rule(pattern = ["git", "log"], decision = "allow", justification = "Permit approved repository log operations; preserve guard and worktree rules.")
prefix_rule(pattern = ["git", "diff"], decision = "allow", justification = "Permit approved repository diff operations; preserve guard and worktree rules.")
prefix_rule(pattern = ["git", "show"], decision = "allow", justification = "Permit approved repository show operations; preserve guard and worktree rules.")
prefix_rule(pattern = ["gh", "pr"], decision = "allow", justification = "Permit reviewed pull-request workflows; guard and branch protection remain required.")
prefix_rule(pattern = ["gh", "run"], decision = "allow", justification = "Permit CI inspection and run management.")
prefix_rule(pattern = ["gh", "auth", "status"], decision = "allow", justification = "Permit authentication status checks without exposing credentials.")
prefix_rule(pattern = ["docker", "compose"], decision = "allow", justification = "Permit approved local development services.")
prefix_rule(pattern = ["gh", "api"], decision = "forbidden", justification = "Administrative and cloud actions stay with Earl in his own terminal.")
prefix_rule(pattern = ["gh", "repo"], decision = "forbidden", justification = "Administrative and cloud actions stay with Earl in his own terminal.")
prefix_rule(pattern = ["gh", "secret"], decision = "forbidden", justification = "Administrative and cloud actions stay with Earl in his own terminal.")
prefix_rule(pattern = ["gh", "ruleset"], decision = "forbidden", justification = "Administrative and cloud actions stay with Earl in his own terminal.")
prefix_rule(pattern = ["doctl"], decision = "forbidden", justification = "Administrative and cloud actions stay with Earl in his own terminal.")
prefix_rule(pattern = ["terraform"], decision = "forbidden", justification = "Administrative and cloud actions stay with Earl in his own terminal.")

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AuthUser {
  last_sign_in_at DateTime? @db.Timestamptz(6)
  created_by_user_id String? @db.Uuid
  auth_user AuthUser? @relation("auth_userToauth_user", fields: [created_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_auth_user AuthUser[] @relation("auth_userToauth_user")
  admin_access_event admin_access_event[]
  mutation_receipt mutation_receipt[]
  id                                       String                  @id @db.Uuid
  created_at                               DateTime                @default(now()) @db.Timestamptz(6)
  kind                                     String
  username                                 String
  username_normalized                      String
  display_name                             String
  enabled                                  Boolean
  auth_version                             Int
  must_change_password                     Boolean
  updated_at                               DateTime                @db.Timestamptz(6)
  back_auth_credential_user_id             AuthCredential[]        @relation("auth_credential_user_id")
  back_attendant_user_id                   Attendant[]             @relation("attendant_user_id")
  back_admin_user_id                       Admin[]                 @relation("admin_user_id")
  back_auth_session_user_id                AuthSession[]           @relation("auth_session_user_id")
  back_verification_challenge_user_id      VerificationChallenge[] @relation("verification_challenge_user_id")
  back_card_customer_link_actor_user_id    CardCustomerLink[]      @relation("card_customer_link_actor_user_id")
  back_purchase_revision_actor_user_id     PurchaseRevision[]      @relation("purchase_revision_actor_user_id")
  back_purchase_revision_decision_actor_id PurchaseRevision[]      @relation("purchase_revision_decision_actor_id")
  back_audit_event_actor_user_id           AuditEvent[]            @relation("audit_event_actor_user_id")

  @@unique([username_normalized], map: "uq_user_username_normalized")
  @@map("auth_user")
}

model AuthCredential {
  id                  String   @id @db.Uuid
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  user_id             String   @db.Uuid
  provider            String
  provider_account_id String
  password_hash       String?
  updated_at          DateTime @db.Timestamptz(6)
  rel_user_id         AuthUser @relation("auth_credential_user_id", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([provider, provider_account_id], map: "uq_credential_provider_account")
  @@index([user_id])
  @@map("auth_credential")
}

model Attendant {
  id                                           String           @id @db.Uuid
  created_at                                   DateTime         @default(now()) @db.Timestamptz(6)
  user_id                                      String           @db.Uuid
  staff_code                                   String
  version                                      Int
  rel_user_id                                  AuthUser         @relation("attendant_user_id", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  back_recovery_grant_originating_attendant_id RecoveryGrant[]  @relation("recovery_grant_originating_attendant_id")
  back_assignment_attendant_id                 Assignment[]     @relation("assignment_attendant_id")
  back_capture_context_attendant_id            CaptureContext[] @relation("capture_context_attendant_id")
  back_purchase_originating_attendant_id       Purchase[]       @relation("purchase_originating_attendant_id")

  @@unique([user_id], map: "uq_attendant_user_id")
  @@unique([staff_code], map: "uq_attendant_staff_code")
  @@map("attendant")
}

model Admin {
  verification_generation BigInt @default(0)
  reset_generation BigInt @default(0)
  mail_request mail_request[]
  id                                          String                   @id @db.Uuid
  created_at                                  DateTime                 @default(now()) @db.Timestamptz(6)
  user_id                                     String                   @db.Uuid
  admin_code                                  String
  email_normalized                            String?
  email_verified_at                           DateTime?                @db.Timestamptz(6)
  role_id                                     String                   @db.Uuid
  version                                     Int
  rel_user_id                                 AuthUser                 @relation("admin_user_id", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_role_id                                 Role                     @relation("admin_role_id", fields: [role_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  back_recovery_grant_admin_id                RecoveryGrant[]          @relation("recovery_grant_admin_id")
  back_assignment_changed_by                  Assignment[]             @relation("assignment_changed_by")
  back_product_price_version_actor_id         ProductPriceVersion[]    @relation("product_price_version_actor_id")
  back_card_batch_created_by                  CardBatch[]              @relation("card_batch_created_by")
  back_customer_identity_change_actor_id      CustomerIdentityChange[] @relation("customer_identity_change_actor_id")
  back_purchase_hold_resolved_by              PurchaseHold[]           @relation("purchase_hold_resolved_by")
  back_duplicate_flag_resolved_by             DuplicateFlag[]          @relation("duplicate_flag_resolved_by")
  back_settings_version_retention_approved_by SettingsVersion[]        @relation("settings_version_retention_approved_by")
  back_settings_version_actor_id              SettingsVersion[]        @relation("settings_version_actor_id")
  back_giveaway_snapshot_actor_id             GiveawaySnapshot[]       @relation("giveaway_snapshot_actor_id")

  @@unique([user_id], map: "uq_admin_user_id")
  @@unique([admin_code], map: "uq_admin_admin_code")
  @@unique([email_normalized], map: "uq_admin_email_normalized")
  @@index([role_id])
  @@map("admin")
}

model Role {
  id                           String           @id @db.Uuid
  created_at                   DateTime         @default(now()) @db.Timestamptz(6)
  name                         String
  is_owner                     Boolean
  enabled                      Boolean
  version                      Int
  back_admin_role_id           Admin[]          @relation("admin_role_id")
  back_role_permission_role_id RolePermission[] @relation("role_permission_role_id")

  @@unique([name], map: "uq_role_name")
  @@map("role")
}

model Permission {
  id                                   String           @id @db.Uuid
  created_at                           DateTime         @default(now()) @db.Timestamptz(6)
  code                                 String
  required_view_code                   String?
  rel_required_view_code               Permission?      @relation("permission_required_view_code", fields: [required_view_code], references: [code], onDelete: Restrict, onUpdate: Restrict)
  back_permission_required_view_code   Permission[]     @relation("permission_required_view_code")
  back_role_permission_permission_code RolePermission[] @relation("role_permission_permission_code")

  @@unique([code], map: "uq_permission_code")
  @@index([required_view_code])
  @@map("permission")
}

model RolePermission {
  created_at          DateTime   @default(now()) @db.Timestamptz(6)
  role_id             String     @db.Uuid
  permission_code     String
  rel_role_id         Role       @relation("role_permission_role_id", fields: [role_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_permission_code Permission @relation("role_permission_permission_code", fields: [permission_code], references: [code], onDelete: Restrict, onUpdate: Restrict)

  @@id([role_id, permission_code])
  @@index([role_id])
  @@index([permission_code])
  @@map("role_permission")
}

model AuthSession {
  access_scope String @default("full")
  last_activity_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  auth_request_dedup auth_request_dedup[]
  id                     String          @id @db.Uuid
  created_at             DateTime        @default(now()) @db.Timestamptz(6)
  user_id                String          @db.Uuid
  secret_verifier        String
  expires_at             DateTime        @db.Timestamptz(6)
  revoked_at             DateTime?       @db.Timestamptz(6)
  auth_version           Int
  last_online_sign_in_at DateTime        @db.Timestamptz(6)
  assignment_id          String?         @db.Uuid
  capture_context_id     String?         @db.Uuid
  rel_user_id            AuthUser        @relation("auth_session_user_id", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_assignment_id      Assignment?     @relation("auth_session_assignment_id", fields: [assignment_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_capture_context_id CaptureContext? @relation("auth_session_capture_context_id", fields: [capture_context_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([secret_verifier], map: "uq_auth_session_secret_verifier")
  @@index([user_id])
  @@index([assignment_id])
  @@index([capture_context_id])
  @@index([user_id, revoked_at, expires_at])
  @@map("auth_session")
  back_attendant_sign_in_request AttendantSignInRequest[]
}

model VerificationChallenge {
  issuance_generation BigInt?
  mail_request_id String? @db.Uuid
  target_key_version String?
  mail_request_mail_request_challenge_idToverification_challenge    mail_request[]           @relation("mail_request_challenge_idToverification_challenge")
  mail_request_verification_challenge_mail_request_idTomail_request mail_request?            @relation("verification_challenge_mail_request_idTomail_request", fields: [mail_request_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id                                         String                   @id @db.Uuid
  created_at                                 DateTime                 @default(now()) @db.Timestamptz(6)
  user_id                                    String?                  @db.Uuid
  customer_id                                String?                  @db.Uuid
  purpose                                    String
  target_digest                              String
  secret_hash                                String
  expires_at                                 DateTime                 @db.Timestamptz(6)
  attempts                                   Int
  max_attempts                               Int
  consumed_at                                DateTime?                @db.Timestamptz(6)
  revoked_at                                 DateTime?                @db.Timestamptz(6)
  operation_id                               String                   @db.Uuid
  version                                    Int
  rel_user_id                                AuthUser?                @relation("verification_challenge_user_id", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_customer_id                            Customer?                @relation("verification_challenge_customer_id", fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  back_customer_identity_change_challenge_id CustomerIdentityChange[] @relation("customer_identity_change_challenge_id")

  @@unique([secret_hash], map: "uq_verification_challenge_secret_hash")
  @@unique([operation_id], map: "uq_verification_challenge_operation_id")
  @@index([user_id])
  @@index([customer_id])
  @@map("verification_challenge")
}

model RecoveryGrant {
  id                                String              @id @db.Uuid
  created_at                        DateTime            @default(now()) @db.Timestamptz(6)
  admin_id                          String              @db.Uuid
  originating_attendant_id          String              @db.Uuid
  device_binding_digest             String
  manifest_digest                   String
  secret_hash                       String
  reason                            String
  expires_at                        DateTime            @db.Timestamptz(6)
  revoked_at                        DateTime?           @db.Timestamptz(6)
  version                           Int
  rel_admin_id                      Admin               @relation("recovery_grant_admin_id", fields: [admin_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_originating_attendant_id      Attendant           @relation("recovery_grant_originating_attendant_id", fields: [originating_attendant_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  back_recovery_grant_item_grant_id RecoveryGrantItem[] @relation("recovery_grant_item_grant_id")

  @@unique([secret_hash], map: "uq_recovery_grant_secret_hash")
  @@index([admin_id])
  @@index([originating_attendant_id])
  @@map("recovery_grant")
}

model RecoveryGrantItem {
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  grant_id       String        @db.Uuid
  operation_id   String        @db.Uuid
  payload_digest String
  photo_digest   String
  rel_grant_id   RecoveryGrant @relation("recovery_grant_item_grant_id", fields: [grant_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([grant_id, operation_id])
  @@index([grant_id])
  @@map("recovery_grant_item")
}

model Station {
 duplicate_reporting_state DuplicateReportingState?
  id                                    String                @id @db.Uuid
  created_at                            DateTime              @default(now()) @db.Timestamptz(6)
  code                                  String
  name                                  String
  timezone                              String
  version                               Int
  back_pump_station_id                  Pump[]                @relation("pump_station_id")
  back_product_price_version_station_id ProductPriceVersion[] @relation("product_price_version_station_id")
  back_purchase_station_id              Purchase[]            @relation("purchase_station_id")
  back_campaign_station_id              Campaign[]            @relation("campaign_station_id")
  back_settings_version_station_id      SettingsVersion[]     @relation("settings_version_station_id")

  @@unique([code], map: "uq_station_code")
  @@map("station")
}

model Product {
  id                                    String                @id @db.Uuid
  created_at                            DateTime              @default(now()) @db.Timestamptz(6)
  code                                  String
  unit                                  String
  back_pump_product_id                  Pump[]                @relation("pump_product_id")
  back_product_price_version_product_id ProductPriceVersion[] @relation("product_price_version_product_id")
  back_purchase_product_id              Purchase[]            @relation("purchase_product_id")

  @@unique([code], map: "uq_product_code")
  @@map("product")
}

model Pump {
  name String
  id                      String       @id @db.Uuid
  created_at              DateTime     @default(now()) @db.Timestamptz(6)
  station_id              String       @db.Uuid
  code                    String
  product_id              String       @db.Uuid
  enabled                 Boolean
  version                 Int
  rel_station_id          Station      @relation("pump_station_id", fields: [station_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_product_id          Product      @relation("pump_product_id", fields: [product_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  back_assignment_pump_id Assignment[] @relation("assignment_pump_id")
  back_purchase_pump_id   Purchase[]   @relation("purchase_pump_id")

  @@unique([station_id, code], map: "uq_pump_station_id_code")
  @@index([station_id])
  @@index([product_id])
  @@map("pump")
}

model Assignment {
  id                                 String           @id @db.Uuid
  created_at                         DateTime         @default(now()) @db.Timestamptz(6)
  attendant_id                       String           @db.Uuid
  pump_id                            String           @db.Uuid
  assignment_version                 Int
  effective_from                     DateTime         @db.Timestamptz(6)
  effective_until                    DateTime?        @db.Timestamptz(6)
  changed_by                         String           @db.Uuid
  reason                             String
  back_auth_session_assignment_id    AuthSession[]    @relation("auth_session_assignment_id")
  rel_attendant_id                   Attendant        @relation("assignment_attendant_id", fields: [attendant_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_pump_id                        Pump             @relation("assignment_pump_id", fields: [pump_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_changed_by                     Admin            @relation("assignment_changed_by", fields: [changed_by], references: [id], onDelete: Restrict, onUpdate: Restrict)
  back_capture_context_assignment_id CaptureContext[] @relation("capture_context_assignment_id")
  back_purchase_assignment_id        Purchase[]       @relation("purchase_assignment_id")

  @@unique([attendant_id, assignment_version], map: "uq_assignment_attendant_id_assignment_version")
  @@index([attendant_id])
  @@index([pump_id])
  @@index([changed_by])
  @@map("assignment")
}

model ProductPriceVersion {
  id                                      String             @id @db.Uuid
  created_at                              DateTime           @default(now()) @db.Timestamptz(6)
  station_id                              String             @db.Uuid
  product_id                              String             @db.Uuid
  version                                 Int
  rate_kobo                               BigInt
  currency                                String             @db.Char(3)
  quantity_precision                      Int                @db.SmallInt
  effective_from                          DateTime           @db.Timestamptz(6)
  actor_id                                String             @db.Uuid
  reason                                  String
  rel_station_id                          Station            @relation("product_price_version_station_id", fields: [station_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_product_id                          Product            @relation("product_price_version_product_id", fields: [product_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_actor_id                            Admin              @relation("product_price_version_actor_id", fields: [actor_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  back_purchase_price_version_id          Purchase[]         @relation("purchase_price_version_id")
  back_purchase_revision_price_version_id PurchaseRevision[] @relation("purchase_revision_price_version_id")

  @@unique([station_id, product_id, version], map: "uq_product_price_version_station_id_product_id_version")
  @@unique([station_id, product_id, effective_from], map: "uq_product_price_version_station_id_product_id_effective_from")
  @@index([station_id])
  @@index([product_id])
  @@index([actor_id])
  @@index([station_id, product_id, effective_from])
  @@map("product_price_version")
}

model CaptureContext {
  id                                   String        @id @db.Uuid
  created_at                           DateTime      @default(now()) @db.Timestamptz(6)
  attendant_id                         String        @db.Uuid
  assignment_id                        String        @db.Uuid
  signed_in_at                         DateTime      @db.Timestamptz(6)
  offline_expires_at                   DateTime      @db.Timestamptz(6)
  seller_name                          String
  seller_username                      String
  device_binding_digest                String
  revoked_at                           DateTime?     @db.Timestamptz(6)
  back_auth_session_capture_context_id AuthSession[] @relation("auth_session_capture_context_id")
  rel_attendant_id                     Attendant     @relation("capture_context_attendant_id", fields: [attendant_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_assignment_id                    Assignment    @relation("capture_context_assignment_id", fields: [assignment_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  back_purchase_capture_context_id     Purchase[]    @relation("purchase_capture_context_id")

  @@index([attendant_id])
  @@index([assignment_id])
  @@map("capture_context")
}

model Customer {
  registered_station_id String? @db.Uuid
  registered_by_user_id String? @db.Uuid
  id                                        String                   @id @db.Uuid
  created_at                                DateTime                 @default(now()) @db.Timestamptz(6)
  customer_code                             String
  name                                      String
  phone_normalized                          String
  category                                  String
  version                                   Int
  back_verification_challenge_customer_id   VerificationChallenge[]  @relation("verification_challenge_customer_id")
  back_card_customer_link_customer_id       CardCustomerLink[]       @relation("card_customer_link_customer_id")
  back_customer_identity_change_customer_id CustomerIdentityChange[] @relation("customer_identity_change_customer_id")
  back_purchase_customer_id                 Purchase[]               @relation("purchase_customer_id")
  back_giveaway_snapshot_row_customer_id    GiveawaySnapshotRow[]    @relation("giveaway_snapshot_row_customer_id")

  @@unique([customer_code], map: "uq_customer_customer_code")
  @@unique([phone_normalized], map: "uq_customer_phone")
  @@map("customer")
}

model CardBatch {
  name String?
  id                 String   @id @db.Uuid
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  batch_code         String
  status             String
  version            Int
  created_by         String   @db.Uuid
  rel_created_by     Admin    @relation("card_batch_created_by", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Restrict)
  back_card_batch_id Card[]   @relation("card_batch_id")

  @@unique([batch_code], map: "uq_card_batch_batch_code")
  @@index([created_by])
  @@map("card_batch")
}

model Card {
  id                              String             @id @db.Uuid
  created_at                      DateTime           @default(now()) @db.Timestamptz(6)
  batch_id                        String             @db.Uuid
  code                            String
  qr_payload                      String
  state                           String
  retired_at                      DateTime?          @db.Timestamptz(6)
  retirement_reason               String?
  replaced_by_card_id             String?            @db.Uuid
  version                         Int
  rel_batch_id                    CardBatch          @relation("card_batch_id", fields: [batch_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_replaced_by_card_id         Card?              @relation("card_replaced_by_card_id", fields: [replaced_by_card_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  back_card_replaced_by_card_id   Card[]             @relation("card_replaced_by_card_id")
  back_card_customer_link_card_id CardCustomerLink[] @relation("card_customer_link_card_id")
  back_purchase_card_id           Purchase[]         @relation("purchase_card_id")

  @@unique([code], map: "uq_card_code")
  @@unique([qr_payload], map: "uq_card_qr_payload")
  @@index([batch_id])
  @@index([replaced_by_card_id])
  @@map("card")
}

model CardCustomerLink {
  id                String    @id @db.Uuid
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  card_id           String    @db.Uuid
  customer_id       String    @db.Uuid
  linked_at         DateTime  @db.Timestamptz(6)
  ended_at          DateTime? @db.Timestamptz(6)
  actor_user_id     String    @db.Uuid
  reason            String
  rel_card_id       Card      @relation("card_customer_link_card_id", fields: [card_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_customer_id   Customer  @relation("card_customer_link_customer_id", fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_actor_user_id AuthUser  @relation("card_customer_link_actor_user_id", fields: [actor_user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([card_id], map: "uq_card_customer_link_card_id")
  @@index([customer_id])
  @@index([actor_user_id])
  @@map("card_customer_link")
}

model CustomerIdentityChange {
  id                    String                 @id @db.Uuid
  created_at            DateTime               @default(now()) @db.Timestamptz(6)
  customer_id           String                 @db.Uuid
  actor_id              String                 @db.Uuid
  operation_id          String                 @db.Uuid
  kind                  String
  challenge_id          String?                @db.Uuid
  manager_review_reason String?
  verification_evidence String
  reason                String
  rel_customer_id       Customer               @relation("customer_identity_change_customer_id", fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_actor_id          Admin                  @relation("customer_identity_change_actor_id", fields: [actor_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_challenge_id      VerificationChallenge? @relation("customer_identity_change_challenge_id", fields: [challenge_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([actor_id, operation_id], map: "uq_customer_identity_change_actor_id_operation_id")
  @@index([customer_id])
  @@index([actor_id])
  @@index([challenge_id])
  @@map("customer_identity_change")
}

model Purchase {
 duplicate_detection_intents DuplicateDetectionIntent[]
  lookup_receipt_input Json? @db.JsonB
  lookup_receipt_input_json String? @db.Text
  lookup_receipt_status String @default("fallback")
  lookup_receipt_claims Json? @db.JsonB
  capture_lower_bound DateTime? @db.Timestamptz(6)
  capture_policy_version String?
  id                                        String                   @id @db.Uuid
  created_at                                DateTime                 @default(now()) @db.Timestamptz(6)
  originating_attendant_id                  String                   @db.Uuid
  operation_id                              String                   @db.Uuid
  payload_digest                            String
  sale_code                                 String
  capture_context_id                        String                   @db.Uuid
  assignment_id                             String                   @db.Uuid
  station_id                                String                   @db.Uuid
  pump_id                                   String                   @db.Uuid
  product_id                                String                   @db.Uuid
  seller_name                               String
  seller_username                           String
  card_code                                 String
  app_captured_at                           DateTime                 @db.Timestamptz(6)
  server_received_at                        DateTime                 @db.Timestamptz(6)
  price_version_id                          String                   @db.Uuid
  basis                                     String
  entered_amount_kobo                       BigInt?
  entered_quantity                          Decimal?                 @db.Decimal(20, 6)
  amount_kobo                               BigInt
  quantity                                  Decimal                  @db.Decimal(20, 6)
  rate_kobo                                 BigInt
  currency                                  String                   @db.Char(3)
  unit                                      String
  quantity_precision                        Int                      @db.SmallInt
  medium                                    String
  expected_photo_digest                     String
  expected_photo_bytes                      BigInt
  card_id                                   String?                  @db.Uuid

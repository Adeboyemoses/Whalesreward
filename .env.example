# Safe local examples only. Supply environment variables through your shell.
TZ=UTC
NEXT_TELEMETRY_DISABLED=1
DATABASE_URL=postgresql://whr:whr@127.0.0.1:5433/whr_dev
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=Whales Rewards <no-reply@example.com>
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=whr-local
STORAGE_ACCESS_KEY_ID=whr-local
STORAGE_SECRET_ACCESS_KEY=local-development-only

# Staging transactional email; set private values only in encrypted runtime configuration.
# Local default is Mailpit; staging default remains noop until explicitly configured.
# Production refuses the allowlist and zoho_cpaas selection.
# EMAIL_PROVIDER=
# ZOHO_CPAAS_API_URL=
# ZOHO_CPAAS_TOKEN=
# EMAIL_FROM=
# EMAIL_ALLOWED_RECIPIENTS=
# Initial staging admin INSERT only; existing email/verification are never overwritten.
# WHR_SEED_ADMIN_EMAIL=

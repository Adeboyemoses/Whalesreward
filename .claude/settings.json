{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "TZ": "UTC",
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Bash(doctl *)",
      "Bash(terraform *)",
      "Bash(gh api *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh ruleset *)",
      "Bash(gh repo create *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo archive *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.codex/hooks/guard.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
